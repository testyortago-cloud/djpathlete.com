rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {

    // Form review videos — open upload scoped to form-reviews path only
    // Auth is enforced at the Next.js API layer (NextAuth session check)
    match /form-reviews/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 200 * 1024 * 1024  // 200MB max
                   && request.resource.contentType.matches('video/.*');
    }

    // Performance assessment videos — open upload scoped to assessments path
    // Auth is enforced at the Next.js API layer (NextAuth session check)
    match /performance-assessments/{assessmentId}/{exerciseId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 200 * 1024 * 1024  // 200MB max
                   && request.resource.contentType.matches('video/.*');
    }

    // Form review voice messages — open upload scoped to form-review-audio path
    // Auth is enforced at the Next.js API layer + path-ownership check
    match /form-review-audio/{userId}/{fileName} {
      allow read: if true;
      allow write: if request.resource.size < 6 * 1024 * 1024  // 6MB max (~5min @ 128kbps)
                   && request.resource.contentType.matches('audio/.*');
    }

    // Funnel page images — PUBLICLY READABLE, and that is the requirement, not
    // a shortcut. A funnel page's `media.src` is baked into the published HTML
    // and served to anonymous visitors, so it must be a DURABLE href: a signed
    // URL would expire and silently break the image on a live campaign page.
    // Writes never happen through this rule — uploads go through the Next.js
    // API with the admin SDK, which bypasses these rules entirely.
    match /funnel-images/{stepId}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Quiz movement-demo clips — PUBLICLY READABLE, same requirement as
    // funnel images above. A quiz question's `media_url` is shipped to
    // anonymous visitors by `publicQuizDefinition` and must be a DURABLE
    // href: a signed URL expires and the visitor is asked to grade a movement
    // they cannot see. Writes never happen through this rule — uploads go
    // through scripts/upload-quiz-media.ts with the admin SDK, which bypasses
    // these rules entirely. See lib/quiz-media-storage.ts.
    match /quiz-media/{quizKey}/{fileName} {
      allow read: if true;
      allow write: if false;
    }

    // Deny everything else by default
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
