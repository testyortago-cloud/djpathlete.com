# Non-secret runtime config for the "darrenjpaulcom" project, deployed with the
# functions by the Firebase CLI (functions/.env.<projectId>). Committed on
# purpose — nothing here is a credential.
#
# PRIVATE_STORAGE_BUCKET is the private GCS bucket holding bookkeeping receipts
# and statements. The Next.js runtime reads the same bucket from Vercel's
# FIREBASE_PRIVATE_BUCKET; the name differs here because Firebase reserves the
# FIREBASE_ prefix for keys in .env files and rejects them at deploy.
PRIVATE_STORAGE_BUCKET=djp-athlete-downloads
