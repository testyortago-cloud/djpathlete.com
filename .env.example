# Supabase
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Supabase > Settings > JWT keys. Signs the short-lived tokens the browser hands
# to realtime.setAuth() so auth.uid() resolves in RLS. Server-only, never public.
SUPABASE_JWT_SECRET=

# NextAuth
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=

# Stripe
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=

# AI (Anthropic Claude)
ANTHROPIC_API_KEY=

# GoHighLevel
GHL_API_KEY=
GHL_LOCATION_ID=
# Shared secret the GHL "Custom Webhook" action sends as x-webhook-secret to
# /api/webhooks/ghl-booking. Unset = the route accepts unsigned posts (dev only).
GHL_WEBHOOK_SECRET=

# ─── Calendly (Full Engine phase 2 — replaces the GoHighLevel calendar) ──────
# All FOUR are needed for the assistant to offer real times AND for bookings to
# arrive; with any of them blank the assistant falls back to a plain link and
# the webhook answers 403 before reading the body.
#
# CALENDLY_API_TOKEN     Personal access token: calendly.com → Integrations &
#                        apps → API & webhooks → Generate token. Used server-
#                        side only, for GET /event_type_available_times and by
#                        scripts/calendly-setup.mjs to register the webhook.
# CALENDLY_EVENT_TYPE_URI  The consult event type's API URI, e.g.
#                        https://api.calendly.com/event_types/<uuid>.
#                        scripts/calendly-setup.mjs prints every event type on
#                        the account so you can pick the one to paste here.
# CALENDLY_SCHEDULING_URL  That event type's PUBLIC booking page, e.g.
#                        https://calendly.com/<user>/consultation. Different
#                        thing from the API URI: the API URI is not a page a
#                        visitor can open. Name/email are prefilled onto this
#                        by query string.
# CALENDLY_WEBHOOK_SIGNING_KEY  Chosen by US at subscription time (the
#                        signing_key field on POST /webhook_subscriptions).
#                        Generate with: openssl rand -hex 32. Calendly signs
#                        `t.<raw body>` with HMAC-SHA256 and sends
#                        Calendly-Webhook-Signature: t=<unix>,v1=<hex>; the
#                        webhook rejects a bad digest AND a timestamp older
#                        than 3 minutes. Unlike Twilio's scheme the URL is not
#                        part of the signed string, so apex vs www does not
#                        matter here.
#
# Webhooks need a PAID Calendly plan (Standard, Teams or Enterprise); the
# availability endpoint works on every plan including Free.
CALENDLY_API_TOKEN=
CALENDLY_EVENT_TYPE_URI=
CALENDLY_SCHEDULING_URL=
CALENDLY_WEBHOOK_SIGNING_KEY=

# CALENDLY_CLIENT_ID / CALENDLY_CLIENT_SECRET  The OAuth app, created at
#                        calendly.com -> Integrations & apps -> API & webhooks
#                        -> OAuth applications. Redirect URI must be exactly
#                        <origin>/api/admin/bookings/calendar/callback.
#                        These replace the per-account CALENDLY_API_TOKEN for
#                        every coach who connects; the four values above remain
#                        as the platform's own not-yet-connected path.
CALENDLY_CLIENT_ID=
CALENDLY_CLIENT_SECRET=

# Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Firebase (Storage, Firestore, AI Functions)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_DATABASE_URL=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
FIREBASE_SERVICE_ACCOUNT_KEY=
# Local dev only: when "true", both the client and Admin SDKs talk to the local
# Firebase emulators (Firestore :8080, RTDB :9000, Storage :9199) instead of prod.
# Don't set this here — use `npm run dev:emu`, which flips it on for that run only.
NEXT_PUBLIC_FIREBASE_USE_EMULATORS=

# Google Analytics (gtag.js) — optional, tag is skipped if unset
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# GA4 Data API (server-side reporting in /admin/ads/ga4-overview)
# 1. Cloud Console → APIs & Services → enable "Google Analytics Data API"
# 2. IAM → Service Accounts → create one → Keys → Add key → JSON → download
# 3. GA4 → Admin → Property access management → add the service-account email
#    as Viewer on the property (no roles needed in GCP)
# 4. Set GA4_PROPERTY_ID to the numeric property ID (Admin → Property settings)
# 5. Set GA4_SERVICE_ACCOUNT_JSON to either the raw JSON key (multi-line) OR
#    its base64 encoding (single-line, recommended for Vercel envs):
#      base64 -w0 service-account.json
GA4_PROPERTY_ID=
GA4_SERVICE_ACCOUNT_JSON=

# Firebase Functions secrets (set via: firebase functions:secrets:set <NAME>)
# ANTHROPIC_API_KEY — same as above, set in Firebase
# SUPABASE_URL — same as NEXT_PUBLIC_SUPABASE_URL
# SUPABASE_SERVICE_ROLE_KEY — same as above
# RESEND_API_KEY — same as above
# TAVILY_API_KEY — web research for blog/social generation (Phase 4)
# ASSEMBLYAI_API_KEY — video transcription (Phase 3)
# META_APP_SECRET — Facebook + Instagram OAuth (Phase 2)
# TIKTOK_APP_SECRET — TikTok Content Posting API (Phase 2)
# YOUTUBE_CLIENT_SECRET — YouTube Data API OAuth (Phase 2)
# LINKEDIN_CLIENT_SECRET — LinkedIn Marketing API (Phase 2)
# APP_URL — public URL of the Next.js app, used by scheduled Functions to
#   call back into /api/admin/internal/* routes (e.g., analytics sync, Phase 5a)
# INTERNAL_CRON_TOKEN — same value as the Vercel env var below; Firebase
#   Functions include it as a Bearer token when calling /api/admin/internal/*

# ---- Starter AI Automation (Phase 1-6) ----
# Public-ish values live in Vercel env. Secrets stay in Firebase secret manager (above).

# Platform OAuth client IDs (public-ish — safe for Vercel env)
META_APP_ID=
TIKTOK_APP_ID=
YOUTUBE_CLIENT_ID=
LINKEDIN_CLIENT_ID=

# Platform OAuth client secrets (sensitive — Vercel env, encrypted)
YOUTUBE_CLIENT_SECRET=
META_APP_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
LINKEDIN_CLIENT_SECRET=

# Printful
PRINTFUL_API_KEY=
PRINTFUL_WEBHOOK_SECRET=
PRINTFUL_STORE_ID=

# Content Studio (Starter AI Automation Phase 1)
# Enables the new Content Studio admin surface (unified videos/social/calendar).
# When 'true', /admin/videos, /admin/social, /admin/calendar redirect into
# /admin/content, and the sidebar shows a single "Content Studio" entry.
CONTENT_STUDIO_ENABLED=false

# Shop
SHOP_ENABLED=false

# ---- Shop Phase 2 ----
AMAZON_ASSOCIATES_TAG=djp-20
FIREBASE_PRIVATE_BUCKET=djp-athlete-downloads
RESEND_AUDIENCE_ID=
SHOP_DIGITAL_ENABLED=false
SHOP_AFFILIATE_ENABLED=false

# ---- Automation orchestration (Phase 5 + 6) ----
# Shared bearer secret used by:
#   - Vercel Cron  → /api/admin/internal/publish-due
#   - Firebase onSchedule functions → Next.js /api/admin/internal/* routes
#   - Firebase runJob (HTTPS) for admin-triggered "Run now" buttons
# Generate with: openssl rand -hex 32
# Same value must be set in Vercel env AND Firebase Functions secrets:
#   firebase functions:secrets:set INTERNAL_CRON_TOKEN
INTERNAL_CRON_TOKEN=

# Public Next.js URL. Firebase Functions POST back here to render email
# previews / compute metrics. Also set as Firebase secret named APP_URL.
#   firebase functions:secrets:set APP_URL
# (Next.js server-side code reads NEXTAUTH_URL; APP_URL is Firebase-side only.)

# Recipient for:
#   - TikTok hybrid publish notifications (Phase 3)
#   - Weekly Content Report email (Phase 5c)
#   - Daily Pulse email (Phase 5d)
# Typically the coach's primary inbox.
COACH_EMAIL=

# Firebase project identifiers for the admin /admin/automation "Run now"
# button. The dispatcher builds the Firebase runJob URL as:
#   https://<region>-<project>.cloudfunctions.net/runJob
# Falls back to NEXT_PUBLIC_FIREBASE_PROJECT_ID + us-central1 if unset.
FIREBASE_PROJECT_ID=
FIREBASE_FUNCTIONS_REGION=us-central1
# Optional full URL override (e.g., if you remap the function behind a custom domain):
# FIREBASE_RUN_JOB_URL=https://automation.darrenjpaul.com/runJob

# Google Ads — Phase 1.1 (OAuth + nightly sync)
# Apply for the Developer Token via Google Ads → Tools & Settings → API Center (1–2 wk approval).
# Engineering builds against a Google Ads test account first; flip to live by swapping this value.
GOOGLE_ADS_DEVELOPER_TOKEN=
# OAuth credentials from Google Cloud Console (APIs & Services → Credentials → OAuth client ID, Web application).
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
# 10-digit Customer ID, no dashes (e.g. 7120798092). If using an MCC, set this to the manager Customer ID.
# Enter it ONCE — a doubled/20-digit value is rejected by Google ("login customer id header could not be validated").
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
# Must match the redirect URI configured in Google Cloud Console exactly.
# Production:  https://www.darrenjpaul.com/api/integrations/google-ads/callback
# Local dev:   http://localhost:3050/api/integrations/google-ads/callback
GOOGLE_ADS_REDIRECT_URI=

# Gmail inbox — surfaces leads in /admin/inbox so you can reply from your own
# Gmail account without leaving the dashboard. Requires a Google Cloud OAuth
# client (Web application) with Gmail API enabled and the redirect URI below
# whitelisted. Scopes requested: gmail.modify + gmail.send + userinfo.email.
#   1. Cloud Console → APIs & Services → Library → enable "Gmail API"
#   2. APIs & Services → OAuth consent screen → External, add your email as a
#      test user (or publish if multiple admins will connect).
#   3. APIs & Services → Credentials → Create Credentials → OAuth client ID →
#      Web application. Add the redirect URI below.
# Production: https://www.darrenjpaul.com/api/integrations/gmail/callback
# Local dev:  http://localhost:3050/api/integrations/gmail/callback
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REDIRECT_URI=

# Google Business Profile reviews — surfaces verified GBP reviews on /about for E-E-A-T.
# Enable "Places API (New)" in Google Cloud Console → APIs & Services → Library.
# API key restrictions: HTTP referrers + restrict to Places API only. Server-side calls only.
GOOGLE_PLACES_API_KEY=
# Place ID for Darren J Paul's Google Business Profile.
# Find it: https://developers.google.com/maps/documentation/places/web-service/place-id
# Format starts with "ChIJ..." — paste from Place ID Finder, NOT a search URL.
GOOGLE_BUSINESS_PLACE_ID=

# Google Search Console — the site property the SEO agent's nightly sync targets.
# Format: "sc-domain:darrenjpaul.com" for domain properties, or
# "https://www.darrenjpaul.com/" for URL-prefix properties.
# The connecting Google account must have access to this property.
#
# Setup checklist:
#   1. Cloud Console → APIs & Services → Library → enable "Google Search Console API".
#   2. APIs & Services → OAuth consent screen → add scope:
#      https://www.googleapis.com/auth/webmasters.readonly
#   3. The existing GOOGLE_CLIENT_ID/SECRET (used by Google Ads) is reused for
#      this OAuth flow — no new client ID needed.
#   4. Set GSC_SITE_URL to the exact site property string from
#      https://search.google.com/search-console/about
GSC_SITE_URL=

# ─── Dev auto-login bypass (LOCAL ONLY) ──────────────────────────────────────
# Set both in .env.local to enable GET /api/dev/login, which mints a NextAuth
# session cookie for the email below and redirects to /admin/dashboard. Lets
# Playwright / curl / scripts hit admin endpoints without typing a password.
#
# Route is triple-gated: refuses unless NODE_ENV !== "production",
# process.env.VERCEL is unset (Vercel sets VERCEL=1 in every deployment),
# AND DEV_AUTH_BYPASS_ENABLED === "true". Never set DEV_AUTH_BYPASS_ENABLED
# in Vercel env. The email must resolve to an existing admin user.
DEV_AUTH_BYPASS_ENABLED=
DEV_AUTH_BYPASS_EMAIL=

# ─── Public chat assistant ───────────────────────────────────────────────────
# Salt for the visitor-origin hash on chat_conversations.ip_hash. REQUIRED for
# POST /api/ask — the route throws rather than falling back to an unsalted
# digest, because sha256 of an IPv4 address is not anonymous: there are only
# 4.3 billion of them and the whole space rainbow-tables in seconds. Rotating
# it makes existing rows uncorrelatable with new ones, which only affects the
# per-IP rate-limit windows (one hour) — so rotate freely.
# Generate with: openssl rand -hex 32
CHAT_IP_SALT=

# ─── Twilio SMS (Lead Engine Stage 2) ────────────────────────────────────────
# TWO credential pairs, and they are NOT interchangeable — both are required
# in production or half the SMS channel is dark:
#
#   SENDING   lib/lead-engine/sms.ts authenticates with the API KEY pair
#             (TWILIO_MAIN_SID + TWILIO_CLIENT_SECRET). An API key can be
#             revoked without rotating the account's auth token, which is why
#             the send path uses one.
#
#   WEBHOOKS  app/api/webhooks/twilio/{inbound,status}/route.ts verify
#             X-Twilio-Signature, and Twilio signs with the ACCOUNT AUTH
#             TOKEN — the API key secret will NOT validate. Both routes
#             answer 403 {"error":"twilio not configured"} before reading the
#             body when TWILIO_AUTH_TOKEN is unset, so a missing value here
#             looks identical to a forged request and silently drops every
#             inbound STOP. That is a compliance failure, not a lost message.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_MAIN_SID=
TWILIO_CLIENT_SECRET=

# Webhook URLs registered in Twilio must match appOrigin() (lib/lead-engine/
# origin.ts) EXACTLY — the signature is an HMAC over the full URL string.
# The apex 307-redirects to www, so the www host is mandatory:
#   inbound: https://www.darrenjpaul.com/api/webhooks/twilio/inbound
#   status:  https://www.darrenjpaul.com/api/webhooks/twilio/status
# The status callback is ALSO set per-message by the sender; the service-level
# one is a fallback for any send that omits it.
